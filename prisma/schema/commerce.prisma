// Commerce Module Enums
enum ProductStatus {
  draft
  active
  archived
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  out_for_delivery
  delivered
  completed
  cancelled
  refunded
}

enum OrderSource {
  walk_in
  pos
  storefront
  manual
}

enum PaymentMethod {
  cash
  card
  transfer
  pos
  other
}

enum MovementType {
  stock_in
  stock_out
  adjustment
  return_stock
  sale
  refund
  purchase
  transfer
}

enum MovementReferenceType {
  order
  purchase
  adjustment
  refund
  stock_take
  transfer
}

enum PurchaseOrderStatus {
  draft
  sent
  partial
  received
  cancelled
}

enum StockTakeStatus {
  in_progress
  completed
  cancelled
}

enum ReturnStatus {
  pending
  approved
  rejected
  completed
}

enum ReturnReason {
  defective
  wrong_item
  not_as_described
  changed_mind
  damaged
  other
}

// How an order reaches the customer. `store_pickup` never appears on a
// DeliveryZone row: pickup is configured once per space in StorePickupSetting
// and synthesised into the option list at read time. It lives in this enum so
// an order can snapshot what the customer chose in a single field.
enum DeliveryType {
  door_to_door
  interstate_hub
  interstate_doorstep
  store_pickup
}

// A refundable hold is not revenue. It is taken at checkout, returned when the
// customer collects, and retained if they never do, so it needs its own
// lifecycle rather than living inside shippingFee.
enum DepositStatus {
  none
  held
  returned
  forfeited
}

enum DiscountType {
  percentage
  fixed_amount
}

enum ExpenseCategory {
  rent
  utilities
  salaries
  supplies
  marketing
  maintenance
  shipping
  taxes
  insurance
  other
}

// Product Model
model Product {
  id          String        @id @default(cuid())
  spaceId     String
  sku         String
  slug        String?
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  costPrice   Decimal       @db.Decimal(10, 2)
  salePrice   Decimal?      @db.Decimal(10, 2)
  onSale      Boolean       @default(false)
  status      ProductStatus @default(draft)
  isPublished Boolean       @default(false)
  categoryId  String?
  tags        String[]      @default([])
  // See Order.clientRequestId.
  clientRequestId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  space              Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  inventoryItems     InventoryItem[]
  orderItems         OrderItem[]
  stockConflicts     StockConflict[]
  suppliers          ProductSupplier[]
  productTags        ProductTag[]
  wishlistItems      WishlistItem[]
  saleEvents         SaleEventProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  stockTakeItems     StockTakeItem[]

  @@unique([spaceId, clientRequestId])
  @@unique([spaceId, sku])
  @@unique([spaceId, slug])
  @@index([spaceId, status])
  @@index([spaceId, categoryId])
  @@index([spaceId, isPublished])
  @@index([spaceId, slug])
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("products")
}

// Product Image Model
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Product Variant Model
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String
  name       String
  price      Decimal @db.Decimal(10, 2)
  costPrice  Decimal @db.Decimal(10, 2)
  attributes Json    @default("{}")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems     InventoryItem[]
  orderItems         OrderItem[]
  stockConflicts     StockConflict[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  stockTakeItems     StockTakeItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

// Category Model (self-referential for hierarchy)
model Category {
  id          String  @id @default(cuid())
  spaceId     String
  name        String
  slug        String
  description String?
  parentId    String?
  // See Order.clientRequestId.
  clientRequestId String?
  sortOrder   Int     @default(0)

  space    Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([spaceId, clientRequestId])
  @@unique([spaceId, slug])
  @@index([spaceId])
  @@index([spaceId, parentId])
  @@map("categories")
}

// Inventory Item Model
model InventoryItem {
  id        String  @id @default(cuid())
  spaceId   String
  productId String
  variantId String?
  location  String  @default("default")

  space          Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements      InventoryMovement[]
  stockConflicts StockConflict[]

  @@unique([spaceId, productId, variantId, location])
  @@index([spaceId])
  @@index([spaceId, productId])
  @@map("inventory_items")
}

// Inventory Movement Model
model InventoryMovement {
  id              String                 @id @default(cuid())
  inventoryItemId String
  type            MovementType
  quantity        Int
  reference       String?
  referenceType   MovementReferenceType?
  notes           String?
  costAtTime      Decimal?               @db.Decimal(10, 2)
  // Idempotency key minted by the client before the write leaves the device.
  // Movements hang off inventory items rather than a space, so this is a
  // global unique, the value is a ULID, which makes that correct and stronger
  // than a per-space one.
  clientRequestId String?                @unique
  createdAt       DateTime               @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([inventoryItemId, createdAt(sort: Desc)])
  @@index([reference, referenceType])
  @@map("inventory_movements")
}

// Customer Model
model Customer {
  id            String   @id @default(cuid())
  spaceId       String
  name          String
  email         String?
  phone         String?
  address       String?
  // Supplied by the storefront from the shopper's Google/Supabase profile.
  // Customers are matched to auth users by email only, so this is a copy, not
  // a link, and it is refreshed on every order.
  avatarUrl     String?
  notes         String?
  /// When this address was proved, by the shopper entering a code we emailed or
  /// following the link beside it. Deliberately ours rather than
  /// `auth.users.email_confirmed_at`: with the project's "Confirm email"
  /// setting off, GoTrue stamps that column at signup for everybody, so it
  /// reports every account as verified and is worse than useless as a signal.
  /// Written by POST /api/storefront/customers/verify-email, which reads the
  /// identity from a verified access token rather than a request body.
  emailVerifiedAt DateTime?
  loyaltyPoints Int      @default(0)
  storeCredit   Decimal  @db.Decimal(10, 2) @default(0)
  birthDate     DateTime?
  tags          String[] @default([])
  // See Order.clientRequestId.
  clientRequestId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  space               Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  orders              Order[]
  discountUsages      DiscountUsage[]
  reviews             Review[]
  wishlists           Wishlist[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([spaceId, email])
  @@unique([spaceId, clientRequestId])
  @@index([spaceId])
  @@index([spaceId, name])
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("customers")
}

// Order Model
model Order {
  id              String         @id @default(cuid())
  spaceId         String
  orderNumber     String
  customerId      String?
  source          OrderSource    @default(walk_in)
  paymentMethod   PaymentMethod?
  status          OrderStatus    @default(pending)
  subtotal        Decimal        @db.Decimal(10, 2)
  tax             Decimal        @db.Decimal(10, 2) @default(0)
  discount        Decimal        @db.Decimal(10, 2) @default(0)
  discountCode    String?
  loyaltyPointsUsed Int          @default(0)
  loyaltyPointsEarned Int        @default(0)
  storeCreditUsed Decimal        @db.Decimal(10, 2) @default(0)
  shippingFee     Decimal        @db.Decimal(10, 2) @default(0)
  deliveryZoneId  String?
  total           Decimal        @db.Decimal(10, 2)
  totalCost       Decimal        @db.Decimal(10, 2) @default(0)
  // Payment processor reference (e.g. Paystack). Queryable for idempotency +
  // webhook reconciliation; unique per space so a replayed checkout can't
  // create a duplicate order.
  paymentReference String?
  // Idempotency key minted by the client before the write leaves the device,
  // so a retry that cannot be told apart from a first attempt lands on the
  // same order instead of creating a second one. Deliberately NOT a reuse of
  // paymentReference: that column is the Paystack reference, and the card path
  // verifies it against Paystack.
  clientRequestId String?
  // Paystack's own transaction id. Distinct from paymentReference, which is the
  // reference we minted and sent; this is what Paystack assigned. Used for
  // reconciliation against their dashboard.
  paymentTransactionId String?
  // Where this order was actually sent, snapshotted at creation. Customer.address
  // is the customer's address *now*; these three are the order's address forever.
  // Null on orders placed before delivery tracking existed.
  shippingName    String?
  shippingAddress String?
  shippingPhone   String?

  // How this order was fulfilled, snapshotted at creation and never updated.
  // deliveryZoneId above is the live FK and goes null when a zone is retired;
  // these five are what the customer actually saw and agreed to, so repricing a
  // zone or deleting it never rewrites the history of an order already placed.
  // deliveryNote is stored in full for the same reason: it is the terms the
  // customer accepted at the moment they paid.
  deliveryType          DeliveryType?
  deliveryState         String?
  deliveryLabel         String?
  deliveryNote          String?       @db.Text
  deliveryPickupAddress String?

  // A refundable hold, kept apart from shippingFee on purpose. It pays no
  // courier and is not revenue: it comes back to the customer on collection or
  // is retained if they never come. Folding it into shippingFee is what would
  // let the free shipping threshold waive it and would overstate income on
  // every out-of-state pickup order.
  depositFee      Decimal        @db.Decimal(10, 2) @default(0)
  depositStatus   DepositStatus  @default(none)
  depositSettledAt DateTime?

  // Store pickup lifecycle. The collection deadline runs from the notification,
  // not from the order date, which is exactly why the notification timestamp has
  // to be recorded: without it there is no defensible basis for releasing
  // somebody's item. pickupOverdueAt is set by a non-destructive on-read sweep;
  // releasing is always a deliberate action.
  pickupNotifiedAt  DateTime?
  pickupDeadlineAt  DateTime?
  pickupOverdueAt   DateTime?
  pickupCollectedAt DateTime?
  pickupReleasedAt  DateTime?

  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  returns        Return[]
  stockConflicts StockConflict[]
  statusHistory  OrderStatusHistory[]

  @@unique([spaceId, orderNumber])
  @@unique([spaceId, paymentReference])
  @@unique([spaceId, clientRequestId])
  @@index([spaceId, status])
  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, customerId])
  @@index([spaceId, source])
  @@map("orders")
}

// Order Item Model
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  name      String
  sku       String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// One row per status transition, written in the same transaction as the change
/// so a row can never disagree with Order.status. changedById is null for
/// system transitions such as the Paystack webhook's pending -> confirmed
/// upgrade.
model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// Commerce Settings Model (one per space)
model CommerceSettings {
  id                  String   @id @default(cuid())
  spaceId             String   @unique
  currency            String   @default("USD")
  taxRate             Decimal  @db.Decimal(5, 2) @default(0)

  // Whether tax applies to the discounted amount or to the full pre-discount
  // subtotal. Nigerian VAT is charged on the consideration actually paid, so
  // true is the default; jurisdictions that tax the list price set it false.
  // Consumed by computeOrderTotals(), see src/lib/utils/order-pricing.ts.
  // Applies to every order path: storefront quote, storefront order, and the
  // POS/dashboard createOrder action.
  taxOnDiscountedAmount Boolean @default(true)

  // Order value at or above which shipping is waived. 0 disables free shipping
  // entirely, which is the default so no existing space silently starts giving
  // it away. Applied in computeOrderTotals() against the discounted goods
  // amount, see src/lib/utils/order-pricing.ts.
  freeShippingThreshold Decimal @db.Decimal(10, 2) @default(0)

  lowStockThreshold   Int      @default(10)
  storeName           String   @default("")
  storeAddress        String   @default("")
  /// Which numbering plan a national-format phone number is read against.
  /// An ISO 3166-1 alpha-2 code, and one of the regions in
  /// src/lib/commerce/phone.ts.
  ///
  /// A shop-level setting rather than a global default because national format
  /// is ambiguous across countries: a GB mobile and an NG mobile are both a
  /// trunk zero and ten digits, so assuming NG everywhere silently turns a
  /// British number into a fabricated Nigerian one. A customer abroad still has
  /// to type a country code, which is what every checkout expects.
  defaultPhoneRegion  String   @default("NG")

  storePhone          String   @default("")
  storeEmail          String   @default("")
  storeLogo           String   @default("")
  receiptFooter       String   @default("")
  loyaltyEnabled      Boolean  @default(false)
  loyaltyPointsPerDollar Int   @default(1)
  loyaltyPointValue   Decimal  @db.Decimal(5, 4) @default(0.01)
  paymentMethods      Json     @default("[]")

  // Storefront payment gateway. Only "paystack" is implemented; the UI lists
  // flutterwave/paddle/stripe as coming soon.
  paymentGateway      String   @default("paystack")

  // Paystack keys for storefront card payments. The secret key is stored
  // AES-256-GCM encrypted (see src/lib/crypto.ts) and is never returned by
  // any API; the public key is served to the storefront via /settings.
  paystackPublicKey   String   @default("")
  paystackSecretKey   String   @default("")

  // Storefront brand & presentation (consumed by /api/storefront/settings).
  // These let an external storefront (e.g. VKT-Bougie) render with the merchant's
  // identity instead of hardcoding strings. Empty strings mean "use storefront default".
  storefrontTagline   String   @default("")
  storefrontUrl       String   @default("")
  whatsappNumber      String   @default("")
  socialInstagram     String   @default("")
  socialTwitter       String   @default("")
  socialFacebook      String   @default("")
  socialTiktok        String   @default("")
  themePrimary        String   @default("")
  themeSecondary      String   @default("")
  themeTertiary       String   @default("")

  updatedAt           DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("commerce_settings")
}

// Delivery Zone Model (merchant-configured shipping options + fees, consumed by
// the storefront for checkout shipping selection).
//
// One row is one thing a customer can pick inside one state. The customer
// chooses their state, then chooses their own area group or hub from that
// state's list: nothing about the typed address influences the fee, because
// these are colloquial courier-sheet names ("Ago Palace", "Iju Ishaga") with no
// administrative boundary to match an address against.
model DeliveryZone {
  id        String   @id @default(cuid())
  spaceId   String
  // The state this option is offered in. NOT NULL with no default and a
  // non-empty CHECK in the database: a default of "" would let rows created
  // through any older path all land in one bucket and collide on name under the
  // unique key below, which is the collision that key exists to prevent.
  state     String
  name      String
  fee       Decimal  @db.Decimal(10, 2)
  deliveryType DeliveryType @default(door_to_door)
  // Where the customer collects, for the handful of hubs whose label is
  // meaningless without it ("Benin-1" tells nobody where to go). Most rows ship
  // without one.
  pickupAddress String?
  // Points at a DeliveryNote in the same space. Keyed rather than inlined so
  // editing the hub terms is one edit, not 74.
  noteKey   String?
  // Floats an option to the top of its state's list ahead of the fee sort, for
  // the areas carrying most of the volume.
  isPinned  Boolean  @default(false)
  // Whether CommerceSettings.freeShippingThreshold may waive this fee. Per row
  // rather than global because one flat threshold across a 3,000-10,000 spread
  // waives them all equally, and the expensive rows are the ones a large order
  // is least likely to repeat on.
  qualifiesForFreeShipping Boolean @default(true)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space  Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  orders Order[]

  // Scoped by state: "Doorstep delivery" and "Agbara hub pickup" are distinct
  // options that must be able to repeat across states.
  @@unique([spaceId, state, name])
  @@index([spaceId, isActive])
  @@index([spaceId, state, isActive])
  @@map("delivery_zones")
}

// Per-space delivery copy, keyed so one edit reaches every option that shows it.
// The interstate hub note is four sentences and repeats under 74 options;
// storing it on each row would mean 74 edits to change a word.
//
// isCollapsible is a property of the copy, not of the option: a four-sentence
// note repeated down a list reads better hidden until the option is selected,
// while the one-line door-to-door note stays visible.
model DeliveryNote {
  id            String   @id @default(cuid())
  spaceId       String
  key           String
  label         String
  body          String   @db.Text
  isCollapsible Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, key])
  @@map("delivery_notes")
}

// Store pickup, configured once per space rather than as a row per state.
//
// It is deliberately not a DeliveryZone: it is available everywhere, it needs
// no delivery address, and outside the home state it carries a refundable hold
// rather than a fee. Two price tiers, keyed off whether the customer is in the
// merchant's own state.
model StorePickupSetting {
  id        String  @id @default(cuid())
  spaceId   String  @unique
  isEnabled Boolean @default(false)
  label     String  @default("Store pickup")
  // Falls back to CommerceSettings.storeAddress when null. Two editable copies
  // of one address drift.
  address   String?
  // The merchant's own state, not a hardcoded "Lagos", so the concept
  // generalises past the first storefront that uses it.
  homeState String

  homeFee         Decimal @db.Decimal(10, 2) @default(0)
  // Display copy ("5-7 working days"). homeHoldDays is the enforceable number.
  homeWindowLabel String
  homeHoldDays    Int
  homeNoteKey     String

  awayFee           Decimal @db.Decimal(10, 2) @default(0)
  // True when the away fee is a hold that comes back on collection rather than
  // revenue. This is what keeps it out of shippingFee and out of the free
  // shipping threshold's reach.
  awayFeeRefundable Boolean @default(true)
  awayWindowLabel   String
  awayHoldDays      Int
  awayNoteKey       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("store_pickup_settings")
}

// Supplier Model
model Supplier {
  id            String   @id @default(cuid())
  spaceId       String
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  website       String?
  notes         String?
  paymentTerms  String?
  leadTimeDays  Int      @default(7)
  isActive      Boolean  @default(true)
  // See Order.clientRequestId.
  clientRequestId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  space          Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@unique([spaceId, clientRequestId])
  @@unique([spaceId, email])
  @@index([spaceId])
  @@index([spaceId, isActive])
  @@map("suppliers")
}

// Product-Supplier relationship (many-to-many with cost info)
model ProductSupplier {
  id            String  @id @default(cuid())
  productId     String
  supplierId    String
  supplierSku   String?
  costPrice     Decimal @db.Decimal(10, 2)
  minOrderQty   Int     @default(1)
  isPreferred   Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
  @@map("product_suppliers")
}

// Purchase Order Model
model PurchaseOrder {
  id              String              @id @default(cuid())
  spaceId         String
  orderNumber     String
  supplierId      String
  status          PurchaseOrderStatus @default(draft)
  subtotal        Decimal             @db.Decimal(10, 2) @default(0)
  tax             Decimal             @db.Decimal(10, 2) @default(0)
  shipping        Decimal             @db.Decimal(10, 2) @default(0)
  total           Decimal             @db.Decimal(10, 2) @default(0)
  notes           String?
  expectedDate    DateTime?
  receivedDate    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  space    Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseOrderItem[]

  @@unique([spaceId, orderNumber])
  @@index([spaceId, status])
  @@index([spaceId, supplierId])
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

// Purchase Order Item Model
model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  // SetNull on delete: name/sku are denormalized, so history survives product deletion
  productId       String?
  variantId       String?
  name            String
  sku             String
  quantity        Int
  receivedQty     Int     @default(0)
  unitCost        Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// Stock Take Model (Physical inventory count)
model StockTake {
  id          String          @id @default(cuid())
  spaceId     String
  reference   String
  status      StockTakeStatus @default(in_progress)
  location    String          @default("default")
  notes       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdBy   String?

  space Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items StockTakeItem[]

  @@unique([spaceId, reference])
  @@index([spaceId, status])
  @@index([spaceId, startedAt(sort: Desc)])
  @@map("stock_takes")
}

// Stock Take Item Model
model StockTakeItem {
  id            String  @id @default(cuid())
  stockTakeId   String
  // SetNull on delete: productName/sku are denormalized, so history survives product deletion
  productId     String?
  variantId     String?
  productName   String
  sku           String
  expectedQty   Int
  countedQty    Int?
  variance      Int?
  notes         String?

  stockTake StockTake       @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([stockTakeId])
  @@map("stock_take_items")
}

// Return Model
model Return {
  id            String       @id @default(cuid())
  spaceId       String
  returnNumber  String
  orderId       String
  customerId    String?
  status        ReturnStatus @default(pending)
  reason        ReturnReason @default(other)
  notes         String?
  refundAmount  Decimal      @db.Decimal(10, 2) @default(0)
  restockItems  Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  space    Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items    ReturnItem[]

  @@unique([spaceId, returnNumber])
  @@index([spaceId, status])
  @@index([spaceId, orderId])
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("returns")
}

// Return Item Model
model ReturnItem {
  id          String  @id @default(cuid())
  returnId    String
  // SetNull on delete: name/sku are denormalized, so history survives product deletion
  productId   String?
  variantId   String?
  name        String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  return  Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@map("return_items")
}

// Discount/Promo Code Model
model Discount {
  id              String       @id @default(cuid())
  spaceId         String
  code            String
  name            String
  description     String?
  type            DiscountType @default(percentage)
  value           Decimal      @db.Decimal(10, 2)
  minOrderAmount  Decimal?     @db.Decimal(10, 2)
  maxDiscount     Decimal?     @db.Decimal(10, 2)
  usageLimit      Int?
  usageCount      Int          @default(0)
  perCustomerLimit Int?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean      @default(true)
  appliesTo       Json         @default("[]") // Product IDs, Category IDs, or "all"
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  space  Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  usages DiscountUsage[]

  @@unique([spaceId, code])
  @@index([spaceId, isActive])
  @@index([spaceId, code])
  @@map("discounts")
}

// Track discount usage per customer
model DiscountUsage {
  id          String   @id @default(cuid())
  discountId  String
  customerId  String
  orderId     String?
  usageCount  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([discountId, customerId])
  @@index([discountId])
  @@index([customerId])
  @@map("discount_usages")
}

// Customer Loyalty Points Model
model LoyaltyTransaction {
  id          String   @id @default(cuid())
  spaceId     String
  customerId  String
  orderId     String?
  points      Int
  type        String   // "earned", "redeemed", "expired", "adjusted"
  description String?
  createdAt   DateTime @default(now())

  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([spaceId, customerId])
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("loyalty_transactions")
}

// Expense Model (for tracking store operational costs)
model Expense {
  id          String          @id @default(cuid())
  spaceId     String
  category    ExpenseCategory @default(other)
  amount      Decimal         @db.Decimal(10, 2)
  description String
  vendor      String?
  receiptUrl  String?
  date        DateTime        @default(now())
  isRecurring Boolean         @default(false)
  // See Order.clientRequestId.
  clientRequestId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, clientRequestId])
  @@index([spaceId, category])
  @@index([spaceId, date(sort: Desc)])
  @@map("expenses")
}

// Held/Parked Transaction Model (for POS)
model HeldTransaction {
  id          String   @id @default(cuid())
  spaceId     String
  reference   String
  customerId  String?
  items       Json     // Cart items
  notes       String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, reference])
  @@index([spaceId])
  @@index([spaceId, expiresAt])
  @@map("held_transactions")
}

// Quick Keys Model (POS shortcuts)
model QuickKey {
  id        String @id @default(cuid())
  spaceId   String
  productId String
  position  Int
  color     String @default("#3b82f6")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, position])
  @@index([spaceId])
  @@map("quick_keys")
}

// ========================================
// WISHLIST SYSTEM
// ========================================

model Wishlist {
  id         String         @id @default(cuid())
  spaceId    String
  customerId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  space    Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@unique([spaceId, customerId])
  @@index([spaceId])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  addedAt    DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

// ========================================
// PRODUCT REVIEWS & RATINGS SYSTEM
// ========================================

// Product Tag Model (flexible tag system)
model ProductTag {
  id        String  @id @default(cuid())
  productId String
  type      TagType
  value     String
  label     String? // Optional display label

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type, value])
  @@index([productId])
  @@index([type])
  @@map("product_tags")
}

enum TagType {
  color
  size
  material
  style
  occasion
  feature
  general
}

// Product Review Model
model Review {
  id               String   @id @default(cuid())
  spaceId          String
  productId        String
  customerId       String?
  customerName     String   // Store name even if customer deleted
  customerEmail    String?
  customerAvatar   String?
  rating           Int      // 1-5
  title            String?
  comment          String
  pros             String[] @default([])
  cons             String[] @default([])
  images           String[] @default([])
  helpful          Int      @default(0)
  notHelpful       Int      @default(0)
  verified         Boolean  @default(false) // Verified purchase
  recommendProduct Boolean  @default(true)
  status           ReviewStatus @default(pending)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  space    Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  votes    ReviewVote[]

  @@index([spaceId, productId])
  @@index([spaceId, status])
  @@index([productId, rating])
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("reviews")
}

enum ReviewStatus {
  pending    // Awaiting moderation
  approved   // Visible on storefront
  rejected   // Hidden from storefront
  flagged    // Flagged for review
}

// Review Vote Model (track who voted)
model ReviewVote {
  id         String  @id @default(cuid())
  reviewId   String
  customerId String?
  ipAddress  String? // For anonymous votes
  isHelpful  Boolean

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, customerId])
  @@unique([reviewId, ipAddress])
  @@index([reviewId])
  @@map("review_votes")
}

// ========================================
// SALE EVENTS SYSTEM
// ========================================

enum SaleEventStatus {
  draft
  scheduled
  active
  ended
}

model SaleEvent {
  id            String       @id @default(cuid())
  spaceId       String
  name          String
  slug          String
  description   String?
  discountType  DiscountType @default(percentage)
  discountValue Decimal      @db.Decimal(10, 2)
  bannerImage   String?
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  space    Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  products SaleEventProduct[]

  @@unique([spaceId, slug])
  @@index([spaceId, startDate, endDate])
  @@index([spaceId, isActive])
  @@map("sale_events")
}

model SaleEventProduct {
  id          String   @id @default(cuid())
  saleEventId String
  productId   String
  salePrice   Decimal? @db.Decimal(10, 2)
  addedAt     DateTime @default(now())

  saleEvent SaleEvent @relation(fields: [saleEventId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([saleEventId, productId])
  @@index([saleEventId])
  @@index([productId])
  @@map("sale_event_products")
}

/// A sale that took more stock than the ledger says the shop had, or took
/// stock that has no ledger entry at all.
///
/// The policy is accept the sale, flag the discrepancy, never refuse. A sale
/// rung offline has already happened: the customer has the goods and the cash
/// is in the drawer, so refusing it at sync destroys a real transaction to
/// protect a number. The number is what is wrong, and the correction has a
/// physical cause someone in the shop has to go and look at.
///
/// Nothing resolves these automatically. An automatic correction hides the
/// reason it happened.
model StockConflict {
  id              String  @id @default(cuid())
  spaceId         String
  orderId         String
  productId       String
  variantId       String?
  /// Null when the line had no inventory item to move stock against.
  inventoryItemId String?
  /// oversell | missing_inventory_item
  kind            String
  quantityOrdered Int
  stockBefore     Int
  stockAfter      Int
  /// An OrderSource (walk_in | pos | storefront | manual), or "sync" when the
  /// sale was queued offline and replayed. Where the discrepancy came from, so
  /// a run of these after an outage is recognisable as one.
  source          String

  resolvedAt     DateTime? @db.Timestamp(3)
  resolvedById   String?
  resolutionNote String?

  createdAt DateTime @default(now()) @db.Timestamp(3)

  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([spaceId, resolvedAt])
  @@index([orderId])
  @@map("stock_conflicts")
}
