# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example is the opt-in. It carries placeholders and public identifiers
# only, never a value, and it is the one place a new deployment can find out
# that SEND_EMAIL_HOOK_SECRET is required. Ignoring it meant it existed on one
# machine and nowhere else.
!.env.example

# vercel
.vercel

# PWA (generated by next-pwa if used)
public/workbox-*.js
public/workbox-*.js.map

# Previous apps
/Meal-Flow
/fintrack

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/generated
