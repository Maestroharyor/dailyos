# Copy this file to .env and fill in values.
# Never commit .env to version control.

# --- Database (Supabase Postgres) -------------------------------------------
# Two-URL split:
#   DATABASE_URL = transaction pooler (:6543, Supavisor). Read at runtime by
#                  src/lib/db.ts via @prisma/adapter-pg. The pgbouncer flag is
#                  required — the pooler runs in transaction mode and does not
#                  support prepared statements without it.
#   DIRECT_URL   = session pooler (:5432). Read by the Prisma CLI through
#                  prisma.config.ts for `db push` / `migrate` / `studio` (DDL).
#
# From Supabase: Project Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres.rrrmgbkqxqaqohejhcec:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.rrrmgbkqxqaqohejhcec:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# --- Supabase Auth ----------------------------------------------------------
# Project Settings > API. The publishable key (sb_publishable_...) replaces the
# legacy anon key and is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://rrrmgbkqxqaqohejhcec.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret key (sb_secret_... / service role). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL & branding ------------------------------------------------------
#   Dev : http://localhost:3000
#   Prod: https://dailyos.foverotechnologies.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DailyOS

# --- Email (Resend) ---------------------------------------------------------
# The platform transport. Used for order notifications, and as the fallback for
# any auth email the hook below cannot attribute to a merchant.
#
# A merchant's own sender is configured per space in Commerce Settings and is
# only used once verified; see docs/auth-email-hook.md.
RESEND_API_KEY=                    # Resend API key (re_...)
EMAIL_FROM_NAME=                   # Sender display name, e.g. DailyOS
EMAIL_FROM=                        # Sender address on a Resend-verified domain
# EMAIL_NAME and EMAIL_ADDRESS are older aliases for the two above, still read
# as a fallback by getFromAddress(). Set the EMAIL_FROM_* pair on new
# deployments; these exist so an existing one does not break.

# --- SMS (Termii) -----------------------------------------------------------
# The platform SMS account, used as the fallback for any space that has not
# configured and verified its own. A merchant's own Termii account and sender ID
# live in Space Settings and are only used once a test send through them has
# succeeded.
#
# Leaving these empty is a supported state: the app does not send SMS, and no
# order fails because of it.
TERMII_API_KEY=                    # Termii API key for the platform account
TERMII_SENDER_ID=                  # Alphanumeric, 3-11 chars, whitelisted by Termii
# Termii issues a per-account base URL from its dashboard to route requests to
# the right regulatory region. api.ng.termii.com is the Nigerian default, not a
# universal one; check the dashboard before assuming it.
TERMII_BASE_URL=                   # Default: https://api.ng.termii.com
#
# Transactional SMS goes over the DND route, which is what reaches
# DND-registered Nigerian subscribers. Set this to "true" ONLY while a sender ID
# is still waiting on DND whitelisting: on the generic route these messages
# silently fail to reach most Nigerian numbers, and MTN blocks delivery between
# 20:00 and 08:00 WAT.
TERMII_GENERIC_ROUTE=              # "true" forces the generic route. Leave empty.
#
# Kill switch. Set to "false" to stop every SMS send without a deploy. Any other
# value, including unset, means enabled: an env var that had to be set to turn
# sending ON would mean a missed deploy variable silently stops customer
# notifications, and nobody notices a message that was never sent.
SMS_ENABLED=                       # "false" disables all SMS. Leave empty.
#
# Signs Termii delivery receipts hitting /api/webhooks/termii. Termii's account
# secret key, which is NOT the API key above; HMAC-SHA512 over the raw body in
# the X-Termii-Signature header. A merchant on their own account configures
# theirs in Space Settings; this is the platform account's.
TERMII_WEBHOOK_SECRET=             # Termii secret key for delivery receipts

# Where "Powered by DailyOS" in a transactional email points. The marketing
# site, deliberately not NEXT_PUBLIC_APP_URL: that is the dashboard, and a
# customer who lands there has nothing to log in with.
# NEXT_PUBLIC_DAILYOS_MARKETING_URL=https://dailyos.foverotechnologies.com

# --- Supabase auth email hook -----------------------------------------------
# Auth email (signup confirmation, OTP, password reset) no longer comes from
# Supabase's own mailer. Supabase calls POST /api/auth/send-email and DailyOS
# renders and sends it, so a storefront customer gets their merchant's branding
# rather than ours. Full setup and rollout order in docs/auth-email-hook.md.

# REQUIRED. `v1,whsec_<base64>`, generated on the Supabase Auth Hooks page.
# Without it the route returns 500 rather than accepting unverified payloads,
# so every auth email silently stops. There is no safe default.
SEND_EMAIL_HOOK_SECRET=

# REQUIRED for link flows. The project ref, used as the host of the verify URL
# the hook assembles. Missing it does not fail loudly: emails still send, but
# with the code only and no clickable link.
SUPABASE_PROJECT_REF=rrrmgbkqxqaqohejhcec

# OPTIONAL. `merchant` (default) or `platform`.
#
# `platform` is the kill switch. It still sends every email, but forces the
# platform transport and neutral DailyOS branding, which neutralises a bad
# merchant configuration without touching the Supabase dashboard. It is not an
# off switch: the only true off switch is deleting the hook there.
#
# Leave unset for normal operation. A deployment left on `platform` is why a
# storefront signup email would arrive branded DailyOS while the order
# confirmation beside it is branded correctly.
# AUTH_EMAIL_HOOK_MODE=merchant

# OPTIONAL. `host=spaceId` pairs, comma separated, mapping staging and preview
# origins onto a space. Needed because those hosts are not the storefrontUrl
# stored in Commerce Settings, so origin matching cannot resolve them.
#   e.g. staging.example.com=<spaceId>,preview.example.com=<spaceId>
# EXTRA_STOREFRONT_ORIGINS=

# --- Service worker ----------------------------------------------------------
# The PWA service worker registers in production only. Set this to "true" to
# register it in development as well, which is the only way to exercise offline
# behaviour locally.
# NEXT_PUBLIC_ENABLE_SW=false

# --- Google OAuth ------------------------------------------------------------
# Configured in the Supabase dashboard (Authentication > Providers > Google),
# NOT in the app. Register the redirect URL {SUPABASE_URL}/auth/v1/callback in
# Google Cloud Console, and {APP_URL}/auth/callback in Supabase URL config.

# --- Storefront CORS --------------------------------------------------------
# Comma-separated origins allowed to call /api/storefront/*.
# REQUIRED: when unset, storefront CORS requests are blocked (no longer
# defaults to "*"). Set "*" explicitly only if you really want any origin.
#   Dev : http://localhost:5173
#   Prod: https://vktbougie.com,https://www.vktbougie.com
STOREFRONT_ALLOWED_ORIGINS=http://localhost:5173,https://vktbougie.com,https://www.vktbougie.com

# --- Payments (Paystack) ------------------------------------------------------
# The merchant's Paystack keys are configured per space in Commerce Settings >
# Storefront Payments (secret stored AES-256-GCM encrypted in the DB).
# Register the webhook URL {APP_URL}/api/webhooks/paystack in the Paystack
# dashboard (Settings > API Keys & Webhooks).

# REQUIRED to save a merchant secret key: deployment-level encryption key for
# secrets at rest. Any long random string (e.g. `openssl rand -base64 32`).
# Rotating it invalidates stored merchant keys (re-save them in settings).
SECRETS_ENCRYPTION_KEY=

# OPTIONAL fallback secret key (sk_test_/sk_live_) used only when the space
# has no key configured in settings. Must match the storefront's public key.
PAYSTACK_SECRET_KEY=
